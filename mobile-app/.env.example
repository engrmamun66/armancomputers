# Copy to .env and adjust per run target, then pass via:
#   flutter run --dart-define-from-file=.env
#   flutter build apk --dart-define-from-file=.env

# Android emulator (10.0.2.2 = host machine's localhost from inside the emulator)
API_BASE_URL=http://10.0.2.2:7878/api
API_ORIGIN=http://10.0.2.2:7878

# Chrome:               http://127.0.0.1:7878/api        http://127.0.0.1:7878
# Real device (LAN IP): http://<your-lan-ip>:7878/api    http://<your-lan-ip>:7878
API_BASE_URL=http://192.168.68.100:7878/api
API_ORIGIN=http://192.168.68.100:7878
